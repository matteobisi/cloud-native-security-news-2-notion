# Notion integration token (ntn_...) with insert-content permission
NOTION_TOKEN=

# Parent page the digest child pages are created under.
# Share that page with the integration.
NOTION_PARENT_PAGE_ID=

# Optional: raises GitHub API rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=

# Docker Model Runner endpoint.
# Inside Docker Compose this is injected by the `models:` block.
# On the host use http://localhost:12434/engines/v1
MODEL_BASE_URL=http://localhost:12434/engines/v1
MODEL_NAME=ai/gemma3:12b-q4_K_M
